__pycache__/
*.pyc
.pytest_cache/
.venv/

# data — recorded and simulated clips, results. Keep the dir structure, not the contents.
corpus/*
!corpus/real
!corpus/sim
# Hand-marked ground truth is kept: small, slow to produce, impossible to reproduce
# exactly. The clips it describes are not. Directories are re-included so git can
# descend far enough to see the side-cars at all.
corpus/real/**
!corpus/real/**/
!corpus/real/.gitkeep
!corpus/real/**/*.labels.csv
!corpus/real/**/*.anchor.json
!corpus/real/**/*.deviation.json
corpus/sim/*
!corpus/sim/.gitkeep
runs/
*.aedat4
*.npz

# Fetched paper PDFs (offline reading; large, not ours to redistribute)
materials/pdfs/
!corpus/sets.yaml
!corpus/bench.yaml
