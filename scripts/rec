#!/usr/bin/env bash
# Record a clip with the Thesis-repo recorder, writing into corpus/real/.
#
#   bash scripts/rec fan_brush_slow_01.aedat4 --preview --no-motors --duration 30
#
# Overridable: THESIS_REPO, THESIS_PY.
set -u -o pipefail

THESIS="${THESIS_REPO:-D:/Projects/Thesis}"
PY="${THESIS_PY:-D:/Programs/Anaconda/envs/thesis/python.exe}"
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ $# -lt 1 ]; then
  echo "usage: bash scripts/rec <name>.aedat4 [recorder flags...]" >&2
  exit 2
fi
name="$1"; shift

mkdir -p "$REPO/corpus/real"
PYTHONPATH="$THESIS" "$PY" -m recording.recorder --out "$REPO/corpus/real/$name" "$@"
